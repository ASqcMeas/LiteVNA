[hardware]
  model = "ZNB"
  address = "TCPIP0::192.168.1.123::inst0::INSTR"
  attenuation = 80
  port = "S43"

[sample]
  name = "dummyTest" # 樣品名稱

[execution]
  action = "run-all"      # 可選: "run-all", "blind-search", "find-windows", "compile", "sweep", "fit"
  dummy = true            # 是否使用模擬模式 (Offline Dummy)

[blind_search]
  start_freq_ghz = 4.0
  stop_freq_ghz = 8.0

[verification]
  # 驗證掃描的參數配置
  points = 501                # 驗證掃描點數
  if_bandwidth_hz = 200       # 驗證掃描中頻頻寬 (Hz)

[fwhm]
  # 頻寬估算與護欄參數
  min_khz = 50.0              # 最小 FWHM 限制 (kHz)
  window_multiplier = 15.0    # 最終掃描窗口為估算 FWHM 的倍數

[blind_search_passes]
  # 多通道盲搜尋的掃描參數
  passes = [
    { power = -15.0, if_bandwidth = 1000, points = 16001, name = "Pass 1 (High Power, -15 dBm)" },
    { power = -35.0, if_bandwidth = 200,  points = 16001, name = "Pass 2 (Low Power, -35 dBm)" },
    { power = -45.0, if_bandwidth = 100,  points = 16001, name = "Pass 3 (Ultra Low Power, -45 dBm)" }
  ]

[resonator_defaults]
  # 輸出到 resonator_PD.toml 的共振腔預設掃描規格
  if_bandwidth = 20
  points = 501
  max_repeat = 5
  min_repeat = 1
  power_ave_ratio = -140
  power_min = -50
  power_max = 0
  power_step = 5

[peak_finding_retry]
  # 最佳化尋找 dip (Step A/B) 的重試與降級機制
  max_retries = 3
  retry_1_points = 1601
  retry_1_ibw_hz = 200
  retry_2_range_multiplier = 2.0
  retry_3_power_boost_db = 5.0
  fallback_window_mhz = 2.0   # 尋找失敗時降級的預設窗口大小 (MHz)

